# This repository does not require a local `.env` file for the default dev loop.
#
# Use this file as the inventory if local-only environment variables are introduced later.
# Keep real values in `.env` (ignored by git), not here.
#
# CI / release secrets live in GitHub Actions secrets.
# Canonical setup guide: .github/SECRETS_SETUP.md
#
# Typical release-related secrets / env values:
# IOS_TEAM_ID=
# APP_STORE_CONNECT_KEY_ID=
# APP_STORE_CONNECT_ISSUER_ID=
# APP_STORE_CONNECT_API_KEY=
# ANDROID_KEYSTORE_BASE64=
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=
#
# Discord / OpenAI bridge for the cmux workspace:
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# DISCORD_ALLOWED_USER_IDS=
# DISCORD_ALLOWED_CHANNEL_IDS=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# DISCORD_EPHEMERAL_RESPONSES=true
#
# Optional local iOS release variable:
# DEVELOPMENT_TEAM=
