[Unit]
Description=hololive OCG Helper Discord cmux bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/hololive_OCG_helper
EnvironmentFile=/etc/hololive_ocg_helper/discord-cmux-bot.env
ExecStart=/opt/hololive_OCG_helper/.venv/bin/python /opt/hololive_OCG_helper/scripts/discord_cmux_bot.py
Restart=always
RestartSec=5
User=hololive
Group=hololive
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/hololive_OCG_helper /home/hololive /var/log/hololive_ocg_helper

[Install]
WantedBy=multi-user.target
